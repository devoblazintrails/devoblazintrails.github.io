---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>https://www.loveunited.solutions/</loc><priority>1.0</priority></url>
{%- for p in site.pages -%}
  {%- if p.sitemap == false or p.noindex or p.url contains ".xml" or p.url contains ".txt" or p.url contains ".css" or p.url contains ".js" or p.url == "/404.html" or p.url == "/" or p.url contains "/page" -%}{%- continue -%}{%- endif -%}
  {%- if p.layout == nil or p.layout == "null" -%}{%- continue -%}{%- endif %}
  <url><loc>https://www.loveunited.solutions{{ p.url }}</loc>{% if p.url contains "/services/" %}<priority>0.9</priority>{% endif %}</url>
{%- endfor %}
{%- for post in site.posts %}
  <url><loc>https://www.loveunited.solutions{{ post.url }}</loc><lastmod>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</lastmod></url>
{%- endfor %}
</urlset>
